# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
# Fallback after primary model exhausts retries (cheaper / more available)
OPENAI_FALLBACK_MODEL=gpt-4o-mini
# Per-attempt call timeout (seconds)
OPENAI_TIMEOUT_SECONDS=30
# Transient failures only (429/5xx/timeout); never retries 400/401
OPENAI_MAX_RETRIES=3
# Open circuit after N consecutive failures; skip API for T seconds
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=60

# Composite confidence (measurable signals — not LLM self-scores)
# Escalate when composite score is below this
CONFIDENCE_ESCALATION_THRESHOLD=0.5
# Prompt + band boundary for "acknowledge uncertainty"
CONFIDENCE_UNCERTAINTY_THRESHOLD=0.7
# Below this best-hit similarity, treat as no usable context (cap 0.3)
RETRIEVAL_MIN_SIMILARITY=0.35
# Second LLM call to score answer groundedness (disable to save cost)
GROUNDEDNESS_ENABLED=true

# Database
POSTGRES_USER=vatecon
POSTGRES_PASSWORD=vatecon_secret
POSTGRES_DB=vatecon_db

# App
SECRET_KEY=change-this-in-production-super-secret-key
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# Default admin (created on first startup if none exists)
ADMIN_EMAIL=admin@vatecon.com
ADMIN_PASSWORD=Admin123!

# CORS
ALLOWED_ORIGINS=http://localhost:3000
